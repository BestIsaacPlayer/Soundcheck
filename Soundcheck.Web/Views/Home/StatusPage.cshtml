@model int

@{
    ViewData["Title"] = "Error " + Model;
}

<h1>@Model</h1>

@switch (Model)
{
    case 403:
        <p>You do not have permission to open this page.</p>
        break;
    case 404:
        <p>The page you are looking for does not exist.</p>
        break;
    default:
        <p>Something went wrong. Please try again later.</p>
        break;
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to the home page</a>
