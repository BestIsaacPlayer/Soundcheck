@model IEnumerable<Soundcheck.Web.Models.EquipmentCategory>

@{
    ViewData["Title"] = "Equipment categories";
}

<h1>Equipment categories</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<p>
    @if (User.IsInRole("Admin"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">Create new category</a>
        </p>
    }
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@category.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
