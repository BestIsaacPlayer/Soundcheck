@using Soundcheck.Web.Models
@model IEnumerable<Booking>

@{
    ViewData["Title"] = "Consultant panel";
}

<h1>Consultant panel</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <p>You have no bookings yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Client</th>
                <th>Category</th>
                <th>Topic</th>
                <th>Date</th>
                <th>Time</th>
                <th>Price</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Client.FullName</td>
                    <td>@booking.EquipmentCategory.Name</td>
                    <td>@booking.Topic</td>
                    <td>@booking.AvailabilitySlot.StartTime.ToString("yyyy-MM-dd")</td>
                    <td>@booking.AvailabilitySlot.StartTime.ToString("HH:mm") - @booking.AvailabilitySlot.EndTime.ToString("HH:mm")</td>
                    <td>@booking.Price.ToString("0.00") PLN</td>
                    <td>@booking.Status</td>
                    <td>
                        @if (booking.Status == BookingStatus.Pending)
                        {
                            <form asp-action="Confirm" asp-route-id="@booking.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Confirm</button>
                            </form>
                        }
                        else if (booking.Status == BookingStatus.Confirmed)
                        {
                            <form asp-action="Complete" asp-route-id="@booking.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success">Mark as completed</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
